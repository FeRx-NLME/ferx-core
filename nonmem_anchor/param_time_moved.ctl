$PROBLEM #1969 parameter time: $PK step on TIME at a dose-tied trough (moved)
$INPUT ID TIME DV AMT EVID CMT MDV
$DATA param_time_moved.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  IND = 1
  IF (TIME.GE.24) IND = THETA(3)
  CL = THETA(1)*IND*EXP(ETA(1))
  V  = THETA(2)*EXP(ETA(2))
  S1 = V
$ERROR
  IPRED = F
  Y = IPRED*(1 + EPS(1)) + EPS(2)
$THETA
  (0.01, 2.0, 100)   ; TVCL
  (1.0, 20.0, 500)   ; TVV
  (0.1, 2.0, 10)     ; IND
$OMEGA 0.09
$OMEGA 0.04
$SIGMA 0.01
$SIGMA 0.0001 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=9999 PRINT=5 NOABORT FORMAT=s1PE23.16
$TABLE ID TIME EVID IND CL IPRED ETA1 ETA2 NOPRINT ONEHEADER NOAPPEND FORMAT=s1PE23.16 FILE=param_time_moved.tab
