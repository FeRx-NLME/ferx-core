# ferx twin (ODE, per-route lag) of nonmem_anchor/addl_lag.ctl (#2367): the same model as
# addl_lag_ode_fit.ferx, with the depot's ALAG1 = 0.25*X written as the route's own lag,
# first_order(ka=KA, lag=0.25*X), on a dose into central. The two are one model: a
# first-order route lagged by L is a depot dosed with ALAG = L. So an ADDL-implied dose
# keeps its parent row's route lag, as NONMEM keeps its ALAG1. Evaluated once
# (maxiter = 0) by tests/record_clock_nonmem_anchor.rs, which compares PRED.
[parameters]
  theta TVCL(0.5, 0.01, 100.0)
  theta TVV(10.0, 0.1, 1000.0)
  theta TVKA(1.0, 0.01, 100.0)
  omega ETA_CL ~ 0.01
  sigma PROP ~ 0.1 (sd)
[individual_parameters]
  CL   = TVCL * exp(ETA_CL)
  V    = TVV
  KA   = TVKA
  LAGR = 0.25 * X
[structural_model]
  ode(states=[central])
[odes]
  d/dt(central) = first_order(ka=KA, lag=LAGR) - CL/V*central
[scaling]
  y = central / V
[covariates]
  X continuous
[error_model]
  DV ~ proportional(PROP)
[fit_options]
  method = foce
  maxiter = 0
  covariance = false
  ode_reltol = 1e-12
  ode_abstol = 1e-12
