$PROBLEM ferx #3121 anchor diagnostics: POSTHOC at the ipred_magnitude.ctl optimum
; MAXEVAL=0 at NONMEM's final estimates: the EBEs, IPRED, IWRES, CWRES and NPDE every
; residual consumer reads through the prediction-reading SD A*EXP(B*IPRED)/SQRT(NIND).
$INPUT ID ARM TIME DV TRT FLARE NIND MDV
$DATA ipred_magnitude.csv IGNORE=@
$PRED
 E0    = THETA(1) + THETA(4)*FLARE + ETA(1)
 EMAX  = THETA(2) + THETA(5)*FLARE + THETA(6)*TRT + ETA(2)
 ET50  = THETA(3) * EXP(THETA(7)*TRT)
 IPRED = E0 - EMAX*TIME/(TIME + ET50)
 W     = THETA(8)*EXP(THETA(9)*IPRED)/SQRT(NIND)
 IWRES = (DV - IPRED)/W
 Y     = IPRED + W*EPS(1)
$THETA
 (1.0, 5.1988064127263920, 20.0)
 (-5.0, 1.1354060587995800, 20.0)
 (0.01, 0.64725298191215153, 20.0)
 (-10.0, 0.96431318073983263, 10.0)
 (-10.0, 0.84221518026902764, 10.0)
 (-10.0, 0.78991800220748587, 10.0)
 (-10.0, -1.1507574976032338, 10.0)
 (0.01, 4.4710616420372471, 100.0)
 (-5.0, -0.17072918146769034, 5.0)
$OMEGA 0.38514057087519554
$OMEGA 0.53922461802591781
$SIGMA 1 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=0 POSTHOC NOABORT SIGL=12 NSIG=4 FORMAT=s1PE23.16
$TABLE ID TIME ETA1 ETA2 FIRSTONLY NOAPPEND NOPRINT ONEHEADER FILE=ipred_magnitude_post.tab FORMAT=s1PE23.16
$TABLE ID TIME DV MDV IPRED IWRES CWRES NOAPPEND NOPRINT ONEHEADER FILE=ipred_magnitude_post.res FORMAT=s1PE23.16
