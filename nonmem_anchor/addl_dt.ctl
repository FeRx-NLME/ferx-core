$PROBLEM #1909: which TIME the $PK of an ADDL-implied dose sees for D1 / R1 (D1 = 0.5 + 0.1*TIME, R1 = 100/(1 + 0.1*TIME))
; same data as addl_dx.mod
$INPUT ID TIME DV MDV EVID AMT RATE CMT ADDL II X
$DATA addl_inf.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2
$PK
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)
  D1 = 0.5 + 0.1*TIME
  R1 = 100/(1 + 0.1*TIME)
  S1 = V
$ERROR
  IPRED = F
  Y = IPRED*(1 + EPS(1))
$THETA (0.5 FIX) (10 FIX)
$OMEGA 0.01 FIX
$SIGMA 0.01 FIX
$ESTIMATION METHOD=0 MAXEVAL=0 PRINT=1 NOABORT
$TABLE ID TIME EVID MDV RATE X PRED NOPRINT ONEHEADER FORMAT=s1PE23.16 FILE=addl_dt.tab
