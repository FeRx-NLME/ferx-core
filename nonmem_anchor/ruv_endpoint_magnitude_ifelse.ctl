$PROBLEM #2731 if/else branches sharing one sigma, factor on one branch, second branch combined
$DATA ruv_endpoint_magnitude.csv IGNORE=@
$INPUT ID TIME DV EVID AMT CMT RATE MDV EARLY ISUR
$SUBROUTINES ADVAN6 TOL=9
$MODEL COMP=(CENTRAL) COMP=(EFFECT)
$PK
  CL  = THETA(1)*EXP(ETA(1))
  V   = THETA(2)*EXP(ETA(2))
  KE0 = THETA(3)
  S1  = V
  IF (AMT.GT.0) TDOS = TIME
  TAD = TIME - TDOS
$DES
  DADT(1) = -CL/V*A(1)
  DADT(2) = KE0*(A(1)/V - A(2))
$ERROR
  IPRED = F
  IF (EARLY.GT.0.5) THEN
    Y = IPRED + EPS(1)*THETA(4)
  ELSE
    Y = IPRED + IPRED*EPS(2) + EPS(1)
  ENDIF
$THETA 2.2 FIX
$THETA 18.0 FIX
$THETA 0.6 FIX
$THETA 1.6 FIX
$OMEGA 0.09 FIX
$OMEGA 0.04 FIX
$SIGMA 0.0625 FIX
$SIGMA 0.04 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=0 PRINT=1 NOABORT
