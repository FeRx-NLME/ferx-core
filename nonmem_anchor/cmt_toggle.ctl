$PROBLEM compartment on/off records, one subject per case (#2732)
$INPUT ID TIME DV EVID AMT CMT MDV RATE II SS ADDL KBC LAGC WT A0C
$DATA cmt_toggle.csv IGNORE=@
$SUBROUTINES ADVAN6 TOL=12
$MODEL COMP=(CENTRAL,DEFDOSE) COMP=(URINE)
$PK
CL = THETA(1)*(WT/70)*EXP(ETA(1))
V  = THETA(2)
K  = CL/V
KB = KBC
ALAG2 = LAGC
A_0(2) = A0C
$DES
DADT(1) = -K*A(1) + KB*A(2)
DADT(2) =  K*A(1) - KB*A(2)
$ERROR
A1 = A(1)
A2 = A(2)
IPRED = A(1)
IF (CMT.EQ.2) IPRED = A(2)
Y = IPRED + EPS(1)
$THETA 1 FIX
$THETA 10 FIX
$OMEGA 0.04
$SIGMA 0.01
$ESTIMATION METHOD=1 INTER MAXEVAL=0
$TABLE ID TIME EVID CMT A1 A2 IPRED PRED NOPRINT NOAPPEND ONEHEADER FILE=cmt_toggle.tab FORMAT=s1PE23.16
