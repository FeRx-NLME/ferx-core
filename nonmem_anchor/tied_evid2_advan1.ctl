$PROBLEM #1810: the same seven ties on ADVAN1 (CL = TVCL*X, V constant)
; ferx twin: tied_evid2_advan1_fit.ferx (same CSV as tied_evid2.ctl).
; Expected PRED (#1809 triage, NONMEM 7.6.0): 4.49329,0.90718 / 2.01897,0.40762 /
;  4.49329,0.90718 / 4.49329,4.49329 / 0.53589 / 0.63675 / 4.49329,4.49329
$INPUT ID TIME DV MDV EVID AMT CMT X
$DATA tied_evid2.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2
$PK
  CL = THETA(1)*X*EXP(ETA(1))
  V  = THETA(2)
  S1 = V
$ERROR
  IPRED = F
  Y = IPRED*(1 + EPS(1))
$THETA (2 FIX) (10 FIX)
$OMEGA 0.01 FIX
$SIGMA 0.01 FIX
$ESTIMATION METHOD=0 MAXEVAL=0 PRINT=1 NOABORT
$TABLE ID TIME EVID X PRED NOPRINT ONEHEADER FORMAT=s1PE17.10 FILE=tied_evid2_advan1.tab
