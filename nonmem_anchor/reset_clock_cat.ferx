# ferx twin of nonmem_anchor/reset_clock_cat.ctl (#1978): TIME read by a binary endpoint's
# linear predictor on data whose period 2 restarts TIME at an EVID=3 row. Parameters at
# NONMEM's optimum (results/reset_clock_cat.ext), evaluated once (maxiter = 0) by
# tests/reset_clock_nonmem_anchor.rs.
[parameters]
  theta TH0(-1.0125653067216978, -10.0, 10.0)
  theta THT(0.028349473864571983, -1.0, 1.0)
  omega ETA_I ~ 0.21416994409132303

[binary_model]
  cmt   = 1
  logit = TH0 + THT * TIME + ETA_I

[fit_options]
  method  = focei
  maxiter = 0
  inner_tol = 1e-8
  covariance = false
