# SS=1 infusions with T_inf > II (overlapping pulses); twin of ss_infusion_overlap_2cpt.ctl.
# Expected values: ss_infusion_overlap_ref_2cpt.csv.

[parameters]
  theta TVCL(2.0, 0.1, 100.0)
  theta TVV(20.0, 1.0, 500.0)
  theta TVQ(4.0, 0.1, 100.0)
  theta TVV2(40.0, 1.0, 500.0)
  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09
  sigma PROP_ERR ~ 0.0025
[individual_parameters]
  CL    = TVCL * (WT/70)^0.75 * exp(ETA_CL)
  V     = TVV * exp(ETA_V)
  Q     = TVQ
  V2    = TVV2
  LAG   = LG
[structural_model]
  pk two_cpt_iv(cl=CL, v1=V, q=Q, v2=V2, lagtime=LAG)
[covariates]
  WT continuous
  LG continuous
[error_model]
  DV ~ proportional(PROP_ERR)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
