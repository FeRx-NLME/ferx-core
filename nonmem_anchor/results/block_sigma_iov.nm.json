  "  OCC3 = 0",
  "  IF(OCC.EQ.1) OCC1 = 1",
  "  IF(OCC.EQ.2) OCC2 = 1",
  "  IF(OCC.EQ.3) OCC3 = 1",
  "  KAPPA = OCC1*ETA(2) + OCC2*ETA(3) + OCC3*ETA(4)",
  "  CL = THETA(1)*EXP(ETA(1) + KAPPA)",
  "  V  = THETA(2)",
  "  S1 = V",
  "",
  "$ERROR",
  "  IPRED = F",
  "  Y = F + F*((1 - FREE)*EPS(1) + FREE*EPS(2))",
  "",
