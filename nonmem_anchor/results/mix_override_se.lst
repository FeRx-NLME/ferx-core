Mon Nov  9 03:22:49 PM UTC 2026
$PROBLEM #2833 probe: free [mixture] omega(2)/sigma(2) override SE at ferx's FOCEI estimate
$INPUT ID TIME DV AMT EVID CMT WT
$DATA mix_override_se.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2
$MIX
  NSPOP = 2
  P(1) = 1 / (1 + EXP(-THETA(4)))
  P(2) = 1 - P(1)
$PK
  IF (MIXNUM.EQ.1) THEN
    CL = THETA(1) * EXP(ETA(1))
  ELSE
    CL = THETA(2) * EXP(ETA(2))
  ENDIF
  V  = THETA(3)
  S1 = V
$ERROR
  IPRED = F
  IF (MIXNUM.EQ.1) THEN
    Y = F * (1 + EPS(1))
  ELSE
    Y = F * (1 + EPS(2))
  ENDIF
$THETA (0.01, 1.2047967374230335, 100.0)
$THETA (0.01, 2.6436593127545596, 100.0)
$THETA (0.1, 10.00618251814227, 1000.0)
$THETA (-10.0, -0.032037516843225214, 10.0)
$OMEGA 0.0607653415782817
$OMEGA 0.266883174876294
$SIGMA 0.010103918167457622
$SIGMA 0.04459326454689841
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=0 POSTHOC SIGL=8 NSIG=2 PRINT=1
$COVARIANCE MATRIX=R SIGL=8 PRINT=E

NM-TRAN MESSAGES
  
 WARNINGS AND ERRORS (IF ANY) FOR PROBLEM    1
             
 (WARNING  2) NM-TRAN INFERS THAT THE DATA ARE POPULATION.
             
 (WARNING  111) $COVARIANCE: IN THE ABSENCE OF $ESTIM OR $MSFI, OR WITH
 $ESTIM MAXEVAL=0, THE UNCONDITIONAL OPTION IS REQUIRED. NM-TRAN HAS
 SUPPLIED THIS OPTION.
  
Note: Analytical 2nd Derivatives are constructed in FSUBS but are never used.
