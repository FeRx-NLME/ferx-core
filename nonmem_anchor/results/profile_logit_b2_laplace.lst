 (-10, 0.01, 10)  ; PLACEBO s10 t0
 (-10, 0.01, 10)  ; PLACEBO s10 t4
 (-10, 0.01, 10)  ; PLACEBO s10 t8
$OMEGA 0.25
$SIGMA 0.0064
$ESTIMATION METHOD=1 LAPLACE INTER MAXEVAL=9999 PRINT=5 NOABORT SIGL=12 NSIG=4 FORMAT=s1PE23.16
