$PROBLEM    #1909: which TIME the $PK of an ADDL-implied dose sees for
;           ALAG1 (ALAG1=0.25 + 0.05*TIME)
; same data as addl_f.mod (round 2)
$INPUT      ID TIME DV MDV EVID AMT RATE CMT ADDL II X
$DATA      addl_dose.csv IGNORE=@
$SUBROUTINE ADVAN2 TRANS2
$PK
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)
  KA = THETA(3)
  ALAG1 = 0.25 + 0.05*TIME
  S2 = V
$ERROR
  IPRED = F
  Y = IPRED*(1 + EPS(1))
$THETA  0.5 FIX
 10 FIX
 1 FIX
$OMEGA  0.01  FIX
$SIGMA  0.01  FIX
$ESTIMATION METHOD=0 MAXEVAL=0 PRINT=1 NOABORT
$TABLE      ID TIME EVID MDV X PRED NOPRINT ONEHEADER FORMAT=s1PE23.16
            FILE=addl_lagt.tab


