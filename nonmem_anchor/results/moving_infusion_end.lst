Wed Nov 18 12:35:39 PM PST 2026
$PROBLEM moving infusion end: RATE=-2 with IIV on D1, multi-dose (#3010)
$INPUT ID TIME AMT RATE DV MDV EVID CMT
$DATA moving_infusion_end.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  CL = THETA(1) * EXP(ETA(1))
  V  = THETA(2) * EXP(ETA(2))
  D1 = THETA(3) * EXP(ETA(3))
  S1 = V
$ERROR
  IPRED = F
  Y = IPRED * (1 + EPS(1))
$THETA (0.1, 3, 100) (1, 25, 500) (0.1, 1.5, 24)
$OMEGA 0.1 0.1 0.1
$SIGMA 0.02
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999 PRINT=10 NOABORT SIGDIG=5

NM-TRAN MESSAGES
  
