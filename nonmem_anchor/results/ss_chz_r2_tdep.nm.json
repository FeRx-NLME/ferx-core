  "$ESTIMATION METHOD=1 LAPLACE INTER NUMERICAL SLOW MAXEVAL=0 POSTHOC PRINT=1 NOABORT",
  "$TABLE ID TIME CMT DV EVID IPRED CHZ HAZ MDV NOPRINT ONEHEADER NOAPPEND FORMAT=s1PE15.8 FILE=r2_tdep.tab"
