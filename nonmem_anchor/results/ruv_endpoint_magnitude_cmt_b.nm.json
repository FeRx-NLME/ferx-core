 "control_stream_as_run": [
  "$PROBLEM #2731 two endpoints, factor on CMT=1, second point TPF=0.7",
  "$DATA ruv_endpoint_magnitude.csv IGNORE=@",
  "$INPUT ID TIME DV EVID AMT CMT RATE MDV EARLY ISUR",
  "$SUBROUTINES ADVAN6 TOL=9",
  "$MODEL COMP=(CENTRAL) COMP=(EFFECT)",
  "$PK",
  "  CL  = THETA(1)*EXP(ETA(1))",
  "  V   = THETA(2)*EXP(ETA(2))",
  "  KE0 = THETA(3)",
  "  S1  = V",
  "  IF (AMT.GT.0) TDOS = TIME",
  "  TAD = TIME - TDOS",
  "$DES",
  "  DADT(1) = -CL/V*A(1)",
  "  DADT(2) = KE0*(A(1)/V - A(2))",
  "$ERROR",
  "  IPRED = F",
  "  FAC = 1 + (THETA(4) - 1)*EARLY",
  "  IF (CMT.EQ.1) THEN",
  "    Y = IPRED + EPS(1)*FAC",
  "  ELSE",
  "    Y = IPRED + EPS(2)",
  "  ENDIF",
  "$THETA 2.2 FIX",
  "$THETA 18.0 FIX",
  "$THETA 0.6 FIX",
