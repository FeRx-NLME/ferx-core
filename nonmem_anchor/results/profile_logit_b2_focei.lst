Mon Nov  2 08:00:37 AM UTC 2026
$PROBLEM ferx #2111 anchor B2: bounded proportion, unstructured placebo inside inv_logit, FOCEI
$INPUT ID STUDY TIME DV CMT EVID MDV TRT NARM
$DATA profile_logit_b2.csv IGNORE=@
$PRED
 TVL  = THETA(1)
 EMAX = THETA(2)
 PLA = 0
 IF (STUDY.EQ.1.AND.TIME.EQ.0) PLA = THETA(3)
 IF (STUDY.EQ.1.AND.TIME.EQ.4) PLA = THETA(4)
 IF (STUDY.EQ.1.AND.TIME.EQ.8) PLA = THETA(5)
 IF (STUDY.EQ.1.AND.TIME.EQ.12) PLA = -(THETA(3)+THETA(4)+THETA(5))
 IF (STUDY.EQ.2.AND.TIME.EQ.0) PLA = THETA(6)
 IF (STUDY.EQ.2.AND.TIME.EQ.4) PLA = THETA(7)
 IF (STUDY.EQ.2.AND.TIME.EQ.8) PLA = THETA(8)
 IF (STUDY.EQ.2.AND.TIME.EQ.12) PLA = -(THETA(6)+THETA(7)+THETA(8))
 IF (STUDY.EQ.3.AND.TIME.EQ.0) PLA = THETA(9)
 IF (STUDY.EQ.3.AND.TIME.EQ.4) PLA = THETA(10)
 IF (STUDY.EQ.3.AND.TIME.EQ.8) PLA = THETA(11)
 IF (STUDY.EQ.3.AND.TIME.EQ.12) PLA = -(THETA(9)+THETA(10)+THETA(11))
 IF (STUDY.EQ.4.AND.TIME.EQ.0) PLA = THETA(12)
 IF (STUDY.EQ.4.AND.TIME.EQ.4) PLA = THETA(13)
 IF (STUDY.EQ.4.AND.TIME.EQ.8) PLA = THETA(14)
 IF (STUDY.EQ.4.AND.TIME.EQ.12) PLA = -(THETA(12)+THETA(13)+THETA(14))
 IF (STUDY.EQ.5.AND.TIME.EQ.0) PLA = THETA(15)
 IF (STUDY.EQ.5.AND.TIME.EQ.4) PLA = THETA(16)
 IF (STUDY.EQ.5.AND.TIME.EQ.8) PLA = THETA(17)
 IF (STUDY.EQ.5.AND.TIME.EQ.12) PLA = -(THETA(15)+THETA(16)+THETA(17))
 IF (STUDY.EQ.6.AND.TIME.EQ.0) PLA = THETA(18)
 IF (STUDY.EQ.6.AND.TIME.EQ.4) PLA = THETA(19)
 IF (STUDY.EQ.6.AND.TIME.EQ.8) PLA = THETA(20)
 IF (STUDY.EQ.6.AND.TIME.EQ.12) PLA = -(THETA(18)+THETA(19)+THETA(20))
 IF (STUDY.EQ.7.AND.TIME.EQ.0) PLA = THETA(21)
 IF (STUDY.EQ.7.AND.TIME.EQ.4) PLA = THETA(22)
 IF (STUDY.EQ.7.AND.TIME.EQ.8) PLA = THETA(23)
 IF (STUDY.EQ.7.AND.TIME.EQ.12) PLA = -(THETA(21)+THETA(22)+THETA(23))
 IF (STUDY.EQ.8.AND.TIME.EQ.0) PLA = THETA(24)
 IF (STUDY.EQ.8.AND.TIME.EQ.4) PLA = THETA(25)
 IF (STUDY.EQ.8.AND.TIME.EQ.8) PLA = THETA(26)
 IF (STUDY.EQ.8.AND.TIME.EQ.12) PLA = -(THETA(24)+THETA(25)+THETA(26))
 IF (STUDY.EQ.9.AND.TIME.EQ.0) PLA = THETA(27)
 IF (STUDY.EQ.9.AND.TIME.EQ.4) PLA = THETA(28)
 IF (STUDY.EQ.9.AND.TIME.EQ.8) PLA = THETA(29)
 IF (STUDY.EQ.9.AND.TIME.EQ.12) PLA = -(THETA(27)+THETA(28)+THETA(29))
 IF (STUDY.EQ.10.AND.TIME.EQ.0) PLA = THETA(30)
 IF (STUDY.EQ.10.AND.TIME.EQ.4) PLA = THETA(31)
 IF (STUDY.EQ.10.AND.TIME.EQ.8) PLA = THETA(32)
 IF (STUDY.EQ.10.AND.TIME.EQ.12) PLA = -(THETA(30)+THETA(31)+THETA(32))
 LP = TVL + PLA + ETA(1) + EMAX * TRT
 IPRED = 1/(1 + EXP(-LP))
 Y = IPRED + EPS(1)
$THETA
 (-5, -0.3, 5)  ; TVL
 (-5, 0.5, 5)   ; EMAX
 (-10, 0.01, 10)  ; PLACEBO s1 t0
