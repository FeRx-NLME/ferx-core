$PROBLEM #1978 reset clock: what $ERROR TIME reads at a binary record after an EVID=3 restart (shifted)
; Two periods per subject, no doses; period 2 opens with an EVID=3 reset at TIME 0. The
; binary endpoint's log-odds is linear in TIME, read in $ERROR. PREDPP (ADVAN1, an empty
; compartment) is there only so the EVID=3 row is a reset as it is in ferx.
; GENERATED by make_reset_clock_arms.py from reset_clock_cat.ctl at the final row of
; results/reset_clock_cat.ext (NONMEM's optimum). MAXEVAL=0: one evaluation at that point.
$INPUT ID TIME DV AMT EVID CMT MDV
$DATA reset_clock_cat_shifted.csv IGNORE=@
$SUBROUTINE ADVAN1 TRANS2
$PK
  CL = 1
  V  = 1
$ERROR
  TT = TIME
  LP = THETA(1) + THETA(2)*TIME + ETA(1)
  P  = 1/(1 + EXP(-LP))
  Y = P
  IF (DV.NE.1) Y = 1 - P
$THETA
  (-10, -1.0125653067216978, 10) ; TH0
  (-1, 0.028349473864571983, 1) ; THT
$OMEGA 0.21416994409132303
$ESTIMATION METHOD=COND LAPLACE LIKE MAXEVAL=0 POSTHOC PRINT=5 NOABORT FORMAT=s1PE23.16
$TABLE ID TIME EVID TT LP P ETA1 NOPRINT ONEHEADER NOAPPEND FORMAT=s1PE23.16
       FILE=reset_clock_cat_shifted.tab
