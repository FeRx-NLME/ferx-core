$PROBLEM ferx #2656 iiv_on_ruv with a dense R: correlation ar1 rho=-0.4
; Generated by make_data.py. Y = F + F*EXP(ETA(3))*(...): ETA(3) scales every residual SD
; of the subject, so R_i(eta) = exp(2*ETA(3)) * R_i(0).
$INPUT ID TIME DV EVID AMT CMT MDV FREE BLK VIS L2
$DATA triple.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2
$PK
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)*EXP(ETA(2))
  S1 = V
$ERROR
  IPRED = F
  RHO = THETA(3)
  B = SQRT(1 - RHO*RHO)
  C1 = 1
  C2 = 0
  C3 = 0
  IF (VIS.EQ.2) THEN
    C1 = RHO
    C2 = B
  ENDIF
  IF (VIS.EQ.3) THEN
    C1 = RHO*RHO
    C2 = RHO*B
    C3 = B
  ENDIF
  RES = C1*EPS(1) + C2*EPS(2) + C3*EPS(3)
  Y = F + F*EXP(ETA(3))*THETA(4)*RES
$THETA 1.05 FIX
$THETA 9.5 FIX
$THETA (-0.9, -0.4, 0.99) FIX
$THETA 0.16 FIX
$OMEGA 0.08 FIX
$OMEGA 0.05 FIX
$OMEGA 0.25 FIX
$SIGMA 1 FIX
$SIGMA 1 FIX
$SIGMA 1 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=0 POSTHOC NOABORT
$TABLE ID TIME ETA1 ETA2 ETA3 FIRSTONLY NOAPPEND NOPRINT ONEHEADER
       FORMAT=s1PE23.16 FILE=ar1_m04.tab
$TABLE ID TIME DV MDV IPRED CWRES NPDE ESAMPLE=2000 SEED=2656 WRESCHOL
       NOAPPEND NOPRINT ONEHEADER FORMAT=s1PE23.16 FILE=ar1_m04.res
