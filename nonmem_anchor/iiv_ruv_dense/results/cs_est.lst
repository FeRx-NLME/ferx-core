Wed Nov  4 04:57:48 AM UTC 2026
$PROBLEM ferx #2656 iiv_on_ruv with a dense R: correlation cs estimation
; Generated by make_data.py. Y = F + F*EXP(ETA(3))*(...): ETA(3) scales every residual SD
; of the subject, so R_i(eta) = exp(2*ETA(3)) * R_i(0).
$INPUT ID TIME DV EVID AMT CMT MDV FREE BLK VIS L2
$DATA triple.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2
$PK
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)*EXP(ETA(2))
  S1 = V
$ERROR
  IPRED = F
  RHO = THETA(3)
  B = SQRT(1 - RHO*RHO)
  GM = RHO*(1 - RHO)/B
  DL = SQRT(1 - RHO*RHO - GM*GM)
  C1 = 1
  C2 = 0
  C3 = 0
  IF (VIS.EQ.2) THEN
    C1 = RHO
    C2 = B
  ENDIF
  IF (VIS.EQ.3) THEN
    C1 = RHO
    C2 = GM
    C3 = DL
  ENDIF
  RES = C1*EPS(1) + C2*EPS(2) + C3*EPS(3)
  Y = F + F*EXP(ETA(3))*THETA(4)*RES
$THETA (0.1, 1.2, 10)
$THETA (1, 12, 100)
$THETA (-0.4, 0.3, 0.95)
$THETA (0.01, 0.2, 2)
$OMEGA 0.1
$OMEGA 0.1
$OMEGA 0.1
$SIGMA 1 FIX
$SIGMA 1 FIX
$SIGMA 1 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=9999 NSIG=3 SIGL=9 PRINT=5 NOABORT

NM-TRAN MESSAGES
  
 WARNINGS AND ERRORS (IF ANY) FOR PROBLEM    1
             
 (WARNING  2) NM-TRAN INFERS THAT THE DATA ARE POPULATION.
  
Note: Analytical 2nd Derivatives are constructed in FSUBS but are never used.
