$PROBLEM ferx #2121 init_seed_tie_ofv_b OFV arm b -- ETA in A_0 at an EVID=2/obs tie
$INPUT ID TIME DV MDV EVID AMT CMT WT
$DATA init_seed_tie_ofv_b.csv IGNORE=@
$SUBROUTINE ADVAN13 TOL=9
$MODEL
  COMP=(CENTRAL, DEFDOSE)
$PK
  CL   = THETA(1)
  V    = THETA(2)
  K    = CL/V
  BASE = THETA(3)*WT*EXP(ETA(1))
  A_0(1) = BASE
$DES
  DADT(1) = -K*A(1)
$ERROR
  IPRED = A(1)/V
  Y = IPRED*(1+EPS(1))
$THETA
  (5.0 FIX)
  (50.0 FIX)
  (10.0 FIX)
$OMEGA 0.09
$SIGMA 0.01
$ESTIMATION MAXEVAL=0 METHOD=1 INTER POSTHOC
$TABLE ID TIME EVID WT IPRED ETA1 NOPRINT ONEHEADER NOAPPEND FORMAT=s1PE23.16 FILE=init_seed_tie_ofv_b.tab
