$PROBLEM advan11_inf_cmt2
$INPUT ID TIME DV AMT CMT EVID RATE SS II
$DATA dose_cmt_advan11_inf_cmt2.csv IGNORE=@
$SUBROUTINES ADVAN11 TRANS4
$PK
  CL = 5
  V1 = 50
  Q2 = 3
  V2 = 80
  Q3 = 1
  V3 = 120
  S1 = V1
$ERROR
  Y = F * (1 + EPS(1))
$THETA (5.0 FIX)   ; CL
$OMEGA 0 FIX
$SIGMA 0.01 FIX
$ESTIMATION MAXEVAL=0 PRINT=1 NOABORT
$TABLE ID TIME CMT PRED NOPRINT ONEHEADER FILE=dose_cmt_advan11_inf_cmt2.tab FORMAT=,1PE17.10
