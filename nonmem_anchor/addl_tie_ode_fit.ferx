# ferx twin (ODE) of nonmem_anchor/addl_tie.ctl (#1909), the same model as
# addl_tie_fit.ferx on the ODE engines. Evaluated once (maxiter = 0) by
# tests/record_clock_nonmem_anchor.rs, which compares PRED.
[parameters]
  theta TVCL(0.5, 0.01, 100.0)
  theta TVV(10.0, 0.1, 1000.0)
  omega ETA_CL ~ 0.01
  sigma PROP ~ 0.1 (sd)
[individual_parameters]
  CL = TVCL * X * exp(ETA_CL)
  V  = TVV
[structural_model]
  ode(states=[central])
[odes]
  d/dt(central) = -CL/V*central
[scaling]
  y = central / V
[covariates]
  X continuous
[error_model]
  DV ~ proportional(PROP)
[fit_options]
  method = foce
  maxiter = 0
  covariance = false
  ode_reltol = 1e-12
  ode_abstol = 1e-12
