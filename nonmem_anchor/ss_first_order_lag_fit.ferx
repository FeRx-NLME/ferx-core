# SS=1 bolus into first_order(ka, lag=) with a PER-ROUTE lag (#2786); twin of
# ss_first_order_lag.ctl.  Expected values: ss_absorption_lag_ref_fo.csv.  The built-in kernel
# has no depot state, so the observation compartment is `central` (CMT 1 in this model); the
# anchor test maps the dataset's CMT 2 observations onto it.  IDs 11-16 (bolus).

[parameters]
  theta TVCL(2.0, 0.1, 100.0)
  theta TVV(20.0, 1.0, 500.0)
  theta TVKA(0.7, 0.01, 24.0)
  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09
  sigma PROP_ERR ~ 0.0025
[individual_parameters]
  CL  = TVCL * (WT/70)^0.75 * exp(ETA_CL)
  V   = TVV * exp(ETA_V)
  KA  = TVKA
  LAG = LG
[structural_model]
  ode(obs_cmt=central, states=[central])
[odes]
  d/dt(central) = first_order(ka=KA, lag=LAG) - CL/V*central
[scaling]
  obs_scale = V
[covariates]
  WT continuous
  LG continuous
[error_model]
  DV ~ proportional(PROP_ERR)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
  ode_method = rk45
  ode_reltol = 1e-12
  ode_abstol = 1e-12
