# V1's typical value reads ETA_CL's anchor TVCL — ferx side of the #1630 case A anchor.
#
# examples/two_cpt_oral_cov.ferx with V1 written as TVCL * TH_R * (WT/70)^THETA_WT_V1,
# an exact reparameterisation of V1 = TVV1 * (WT/70)^THETA_WT_V1 (TVV1 = TVCL*TH_R;
# the declared TVV1 is FIXed and unused). ETA_CL's covariate mu-reference supersedes
# its single-anchor pair on TVCL, so that pair never runs. Before #1630 ferx declined
# V1's covariate mu-reference over it anyway and the CL group's M-step moved TVCL with
# ETA_V1 frozen: OFV 10-29 units above the control, THETA_CRCL 0.16-0.24 against 0.556.
# The two groups now share TVCL and take one joint M-step (#1620).
#
# NONMEM side: covmuref_anchor_a_saem.ctl (METHOD=SAEM) on covmuref_shared.csv.
# Pinned by tests/saem_covariate_mu_ref.rs (slow-gated).

[parameters]
  theta TVCL(4.0, 0.1, 100.0)
  theta TVV1(40.0, 1.0, 500.0) FIX
  theta TVQ(8.0, 0.1, 100.0)
  theta TVV2(80.0, 1.0, 500.0)
  theta TVKA(1.0, 0.01, 10.0)
  theta THETA_WT(0.6, 0.01, 5.0)
  theta THETA_CRCL(0.3, 0.01, 5.0)
  theta THETA_WT_V1(0.6, 0.01, 5.0)
  theta TH_R(10.0, 0.01, 500.0)

  omega ETA_CL ~ 0.15
  omega ETA_V1 ~ 0.15
  omega ETA_Q  ~ 0.08
  omega ETA_V2 ~ 0.08
  omega ETA_KA ~ 0.20

  sigma PROP_ERR ~ 0.04 (sd)

[individual_parameters]
  CL = TVCL * (WT / 70)^THETA_WT * (CRCL / 100)^THETA_CRCL * exp(ETA_CL)
  V1 = TVCL * TH_R * (WT / 70)^THETA_WT_V1 * exp(ETA_V1)
  Q  = TVQ  * exp(ETA_Q)
  V2 = TVV2 * exp(ETA_V2)
  KA = TVKA * exp(ETA_KA)

[structural_model]
  pk two_cpt_oral(cl=CL, v1=V1, q=Q, v2=V2, ka=KA)

[covariates]
  WT   continuous
  CRCL continuous

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method        = saem
  n_exploration = 150
  n_convergence = 250
  seed          = 1
  covariance    = false
