# SS=1 dose into a zero_order() window with a PER-ROUTE lag (#2786); twin of ss_zero_order_lag.ctl.
# Expected values: ss_absorption_lag_ref_zo.csv (and NONMEM's results/ss_zero_order_lag.tab).
# The dataset codes RATE = -2 (NONMEM's D1); the anchor test reads it as a plain bolus record and
# lets `zero_order(dur=DUR)` carry the window, DUR/LAG being the DR/LG covariates.

[parameters]
  theta TVCL(2.0, 0.1, 100.0)
  theta TVV(20.0, 1.0, 500.0)
  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09
  sigma PROP_ERR ~ 0.0025
[individual_parameters]
  CL  = TVCL * (WT/70)^0.75 * exp(ETA_CL)
  V   = TVV * exp(ETA_V)
  DUR = DR
  LAG = LG
[structural_model]
  ode(obs_cmt=central, states=[central])
[odes]
  d/dt(central) = zero_order(dur=DUR, lag=LAG) - CL/V*central
[scaling]
  obs_scale = V
[covariates]
  WT continuous
  DR continuous
  LG continuous
[error_model]
  DV ~ proportional(PROP_ERR)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
  ode_method = rk45
  ode_reltol = 1e-12
  ode_abstol = 1e-12
