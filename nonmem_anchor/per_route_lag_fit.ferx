# ferx per-route-lag anchor model — mirrors nonmem_anchor/per_route_lag.ctl
#
# Two first-order (Bateman) pathways feeding a 1-cpt central, split by a dose
# fraction (FR1 immediate-release / FR2 = 1-FR1 delayed-release), where the DR
# pathway carries its OWN per-route lag via `first_order(ka=KA2, lag=LAG2)`. central
# (CMT 1) holds the drug AMOUNT and receives FR1*first_order(ka=KA1) +
# FR2*first_order(ka=KA2, lag=LAG2); concentration = central / V via [scaling]. Runs
# on data/per_route_lag_oral.csv (every record on CMT 1), the ferx-keyed copy of
# nonmem_anchor/per_route_lag_oral.csv.
#
#   cargo run --release -p ferx-cli -- nonmem_anchor/per_route_lag_fit.ferx \
#     --data data/per_route_lag_oral.csv
#
# The dataset is simulated FROM this per-route-lag model (same truths), so this is a
# matched fit: cross-check the OFV/THETA against the NONMEM run
# (results/per_route_lag.ext) at the shared optimum, and both should recover TVCL=5,
# TVV=50, TVFR1=0.5, TVKA1=1.2, TVKA2=0.8, TVLAG2=3.0. Tight ODE tolerances match
# NONMEM's TOL=9. A per-route lag routes the fit to finite differences (the analytic
# per-route onset saltation is a follow-up); predictions are exact regardless, so the
# eval-at-optimum OFV comparison is unaffected. KA1 > KA2 bounds (and the LAG2 > 0
# lag) break the pathway-label symmetry (keep the same convention as the .ctl).

[parameters]
  theta TVCL(5.0,     0.1, 100.0)
  theta TVV(50.0,     5.0, 500.0)
  theta TVFR1(0.5,  0.001, 0.999)   # immediate-release fraction
  theta TVKA1(1.2,    0.3,  24.0)   # IR pathway (bounded > KA2)
  theta TVKA2(0.8,   0.05,   1.1)   # DR pathway
  theta TVLAG2(3.0, 0.001,  12.0)   # DR-pathway per-route lag (h)

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09

  sigma PROP_ERR ~ 0.15 (sd)

[individual_parameters]
  CL   = TVCL * exp(ETA_CL)
  V    = TVV  * exp(ETA_V)
  FR1  = TVFR1
  FR2  = 1 - TVFR1
  KA1  = TVKA1
  KA2  = TVKA2
  LAG2 = TVLAG2

[structural_model]
  ode(states=[central])

[odes]
  d/dt(central) = FR1*first_order(ka=KA1) + FR2*first_order(ka=KA2, lag=LAG2) - CL/V*central

[scaling]
  y = central / V

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method     = focei
  ode_reltol = 1e-9
  ode_abstol = 1e-11
  covariance = true
