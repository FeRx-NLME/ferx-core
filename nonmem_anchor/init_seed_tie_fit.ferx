# ferx twin of init_seed_tie.ctl / init_seed_tie_cells.ctl (#2121).
#
# WT reaches the prediction only through the `init()` seed, so IPRED at a subject's first
# instant reads the seed directly: 14 for WT = 70, 28 for WT = 140. Which co-timed record
# supplies WT is the question under test (NONMEM: the first record in file order).

[parameters]
  theta TVCL(5.0, 0.0, 1e15)
  theta TVV(50.0, 0.0, 1e15)
  theta TVBASE(10.0, 0.0, 1e15)
  sigma PROP ~ 0.01
[individual_parameters]
  CL   = TVCL
  V    = TVV
  BASE = TVBASE * WT
[structural_model]
  ode(obs_cmt=central, states=[central])
[odes]
  init(central)  = BASE
  d/dt(central)  = -(CL/V) * central
[covariates]
  WT continuous
[scaling]
  y = central / V
[error_model]
  DV ~ proportional(PROP)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
  ode_reltol = 1e-10
  ode_abstol = 1e-12
