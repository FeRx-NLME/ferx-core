# ferx twin of derived_break_tie.ctl (#2534): K = 0.1, KA = 1, ALAG1 = 2.96 on the depot.

[parameters]
  theta TVK(0.1, 0.0, 1e15)
  theta TVLAG(2.96, 0.0, 1e15)
  sigma PROP ~ 0.01
[individual_parameters]
  K     = TVK
  ALAG1 = TVLAG
  KA    = 1.0
[structural_model]
  ode(obs_cmt=central, states=[depot, central])
[odes]
  d/dt(depot)   = -KA * depot
  d/dt(central) = KA * depot - K * central
[error_model]
  DV ~ proportional(PROP)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
  ode_reltol = 1e-12
  ode_abstol = 1e-12
