# Allometric CL with an estimated exponent, SAEM — ferx side of the #619 anchor.
#
# `CL = TVCL * (WT/70)^TH_WT * exp(ETA_CL)` always had a single-anchor
# mu-reference on TVCL (the power factor is opaque to `collect_mul_anchors`),
# so TVCL took the closed-form shift while TH_WT sat on the eta-frozen
# numerical M-step. With #619 the two thetas form a covariate mu-reference on
# ETA_CL and are re-fitted jointly to the population of individual log-CL
# values; `mu_refs` still carries the TVCL anchor for every other consumer.
# NONMEM's `MU_1 = LOG(THETA(1)) + THETA(2)*LOG(WT/70)` is linear in theta —
# the efficient MU form — so this anchor also checks the group step does not
# lose ground on the case NONMEM handles best.
#
# Data: data/covmuref_power.csv (nonmem_anchor/simulate_covmuref_data.py).
# Truths: TVCL=5, TH_WT=0.75, TVV=50, omega^2 = 0.09 (CL), 0.04 (V),
#         sigma (SD) = 0.10. Starts deliberately away from truth.

[parameters]
  theta TVCL(4.0,   0.0, 100.0)
  theta TH_WT(0.3, -2.0,   3.0)
  theta TVV(40.0,   1.0, 500.0)

  omega ETA_CL ~ 0.1
  omega ETA_V  ~ 0.1

  sigma PROP_ERR ~ 0.02

[individual_parameters]
  CL = TVCL * (WT / 70.0) ^ TH_WT * exp(ETA_CL)
  V  = TVV * exp(ETA_V)

[structural_model]
  pk one_cpt_iv(cl=CL, v=V)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method = saem
  seed = 619
