$PROBLEM #2730 descent from eta = 0 only: the shallow mode of subject 1
$INPUT ID TIME DV EVID AMT CMT OCC
$DATA iov_kappa_two_mode.csv IGNORE=@
$SUBROUTINES ADVAN2 TRANS2
$PK
  OCC1 = 0
  OCC2 = 0
  IF (OCC.EQ.1) OCC1 = 1
  IF (OCC.EQ.2) OCC2 = 1
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)*EXP(ETA(2))
  KA = THETA(3)*EXP(OCC1*ETA(3)+OCC2*ETA(4))
  S2 = V
$ERROR
  Y = F + EPS(1)
$THETA 1 FIX
$THETA 10 FIX
$THETA 1 FIX
$OMEGA 0.09 FIX
$OMEGA 0.09 FIX
$OMEGA BLOCK(1) 1 FIX
$OMEGA BLOCK(1) SAME
$SIGMA 0.09 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=0 NOABORT
$TABLE ID TIME ETAS(1:LAST) NOPRINT ONEHEADER FILE=iov_kappa_two_mode.tab FORMAT=s1PE23.16
