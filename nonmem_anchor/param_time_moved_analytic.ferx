# ferx twin (analytic) of nonmem_anchor/param_time_moved.ctl (#1969): the TIME that
# [individual_parameters] reads is the TIME as written. Parameters at NONMEM's optimum
# (results/param_time_moved.ext), evaluated once (maxiter = 0) by
# tests/param_time_written_nonmem_anchor.rs.
[parameters]
  theta TVCL(2.1632593260127178, 0.01, 100.0)
  theta TVV(20.478990877463385, 1.0, 500.0)
  theta TVIND(1.9559363870816417, 0.1, 10.0)
  omega ETA_CL ~ 0.09712282470252731
  omega ETA_V  ~ 0.04476213826267286
  sigma PROP_ERR ~ 0.10344102217790695 (sd)
  sigma ADD_ERR ~ 0.0001 (variance) FIX

[individual_parameters]
  IND = if (TIME >= 24.0) TVIND else 1.0
  CL = TVCL * IND * exp(ETA_CL)
  V  = TVV * exp(ETA_V)

[structural_model]
  pk one_cpt_iv(cl=CL, v=V)

[error_model]
  DV ~ combined(PROP_ERR, ADD_ERR)

[fit_options]
  method  = focei
  maxiter = 0
  inner_tol = 1e-8
  covariance = false
