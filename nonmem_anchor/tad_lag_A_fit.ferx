# ferx twin of nonmem_anchor runA (#1070).
#
# WT carries a FIXED-at-zero exponent, so (WT/70)^0 == 1 exactly and WT has no
# effect on any prediction. It is present only because ferx routes a subject to
# the event-driven predictor when a covariate column actually varies within the
# subject. (That routing was originally needed because the plain (dense) predictor
# answered NaN for a TAD-reading RHS under a lagtime; #1073 fixed that, and it is
# kept as belt-and-braces.) With a zero exponent every per-event covariate snapshot
# is identical, so this anchor does not exercise the TV-covariate snapshot
# convention and cannot be invalidated by #1073.

[parameters]
  theta TVCL(1.0, 0.001, 100.0)
  theta TVV(20.0, 0.001, 500.0)
  theta THETA_TAD(0.3, 0.0, 10.0)
  theta TVLAG(0.5, 0.001, 10.0)
  theta THETA_WT(0.0, -5.0, 5.0) FIX
  omega ETA_CL ~ 0.09
  omega ETA_LAG ~ 0.02
  sigma PROP ~ 0.1 (sd)

[individual_parameters]
  CL      = TVCL * (WT / 70)^THETA_WT * exp(ETA_CL)
  V       = TVV
  KTAD    = THETA_TAD
  LAGTIME = TVLAG * exp(ETA_LAG)

[structural_model]
  ode(states=[central])

[odes]
  d/dt(central) = -(CL/V) * central * (1.0 + KTAD * TAD)

[scaling]
  y = central / V

[covariates]
  WT continuous

[error_model]
  DV ~ proportional(PROP)

[fit_options]
  maxiter    = 0
  covariance = false
  ode_method = rk45
  ode_reltol = 1e-9
  ode_abstol = 1e-11
  inner_tol  = 1e-6
