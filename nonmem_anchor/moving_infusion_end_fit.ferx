# ferx twin of moving_infusion_end.ctl (#3010): a duration-modeled infusion (RATE=-2) with IIV
# on D1, as a linear [odes] model, so its infusion ends are walked inside their dosing
# interval rather than sorted against the observations.
[parameters]
  theta TVCL(3.0, 0.1, 100.0)
  theta TVV(25.0, 1.0, 500.0)
  theta TVD1(1.5, 0.1, 24.0)
  omega ETA_CL ~ 0.1
  omega ETA_V ~ 0.1
  omega ETA_D1 ~ 0.1
  sigma PROP_ERR ~ 0.02
[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V = TVV * exp(ETA_V)
  D1 = TVD1 * exp(ETA_D1)
[structural_model]
  ode(states=[central])
[odes]
  d/dt(central) = -(CL/V) * central
[scaling]
  y = central / V
[error_model]
  DV ~ proportional(PROP_ERR)
[fit_options]
  method = focei
