$PROBLEM ferx #1890 level SE anchor, variant a (last visit dependent)
$INPUT ID STUDY OCC TIME DV MDV NARM SE DOSE
$DATA level_se_mbma.csv IGNORE=@
$PRED
 TVE0 = THETA(1)
 EMAX = THETA(2)
 ED50 = THETA(3)
 ET50 = THETA(4)
 PLA = 0
 IF (STUDY.EQ.1.AND.TIME.EQ.0) PLA = THETA(5)
 IF (STUDY.EQ.1.AND.TIME.EQ.2) PLA = THETA(6)
 IF (STUDY.EQ.1.AND.TIME.EQ.8) PLA = THETA(7)
 IF (STUDY.EQ.1.AND.TIME.EQ.12) PLA = -(THETA(5)+THETA(6)+THETA(7))
 IF (STUDY.EQ.2.AND.TIME.EQ.0) PLA = THETA(8)
 IF (STUDY.EQ.2.AND.TIME.EQ.2) PLA = THETA(9)
 IF (STUDY.EQ.2.AND.TIME.EQ.8) PLA = THETA(10)
 IF (STUDY.EQ.2.AND.TIME.EQ.12) PLA = -(THETA(8)+THETA(9)+THETA(10))
 IF (STUDY.EQ.3.AND.TIME.EQ.0) PLA = THETA(11)
 IF (STUDY.EQ.3.AND.TIME.EQ.2) PLA = THETA(12)
 IF (STUDY.EQ.3.AND.TIME.EQ.4) PLA = THETA(13)
 IF (STUDY.EQ.3.AND.TIME.EQ.12) PLA = -(THETA(11)+THETA(12)+THETA(13))
 IF (STUDY.EQ.4.AND.TIME.EQ.0) PLA = THETA(14)
 IF (STUDY.EQ.4.AND.TIME.EQ.4) PLA = THETA(15)
 IF (STUDY.EQ.4.AND.TIME.EQ.8) PLA = THETA(16)
 IF (STUDY.EQ.4.AND.TIME.EQ.12) PLA = -(THETA(14)+THETA(15)+THETA(16))
 IF (STUDY.EQ.5.AND.TIME.EQ.0) PLA = THETA(17)
 IF (STUDY.EQ.5.AND.TIME.EQ.2) PLA = THETA(18)
 IF (STUDY.EQ.5.AND.TIME.EQ.4) PLA = THETA(19)
 IF (STUDY.EQ.5.AND.TIME.EQ.12) PLA = -(THETA(17)+THETA(18)+THETA(19))
 IF (STUDY.EQ.6.AND.TIME.EQ.0) PLA = THETA(20)
 IF (STUDY.EQ.6.AND.TIME.EQ.2) PLA = THETA(21)
 IF (STUDY.EQ.6.AND.TIME.EQ.4) PLA = THETA(22)
 IF (STUDY.EQ.6.AND.TIME.EQ.8) PLA = -(THETA(20)+THETA(21)+THETA(22))
 BASE = TVE0 + PLA + ETA(1)
 DRUG = EMAX * DOSE / (ED50 + DOSE) * TIME / (TIME + ET50)
 IPRED = BASE - DRUG
 Y = IPRED + SE * EPS(1)
$THETA
 (0, 45, 200)     ; TVE0
 (0, 8, 100)      ; EMAX
 (0.1, 20, 1000)  ; ED50
 (0.01, 2, 100)   ; ET50
 (-50, 0.1, 50) ; PLACEBO[STUDY=1,TIME=0]
 (-50, 0.1, 50) ; PLACEBO[STUDY=1,TIME=2]
 (-50, 0.1, 50) ; PLACEBO[STUDY=1,TIME=8]
 (-50, 0.1, 50) ; PLACEBO[STUDY=2,TIME=0]
 (-50, 0.1, 50) ; PLACEBO[STUDY=2,TIME=2]
 (-50, 0.1, 50) ; PLACEBO[STUDY=2,TIME=8]
 (-50, 0.1, 50) ; PLACEBO[STUDY=3,TIME=0]
 (-50, 0.1, 50) ; PLACEBO[STUDY=3,TIME=2]
 (-50, 0.1, 50) ; PLACEBO[STUDY=3,TIME=4]
 (-50, 0.1, 50) ; PLACEBO[STUDY=4,TIME=0]
 (-50, 0.1, 50) ; PLACEBO[STUDY=4,TIME=4]
 (-50, 0.1, 50) ; PLACEBO[STUDY=4,TIME=8]
 (-50, 0.1, 50) ; PLACEBO[STUDY=5,TIME=0]
 (-50, 0.1, 50) ; PLACEBO[STUDY=5,TIME=2]
 (-50, 0.1, 50) ; PLACEBO[STUDY=5,TIME=4]
 (-50, 0.1, 50) ; PLACEBO[STUDY=6,TIME=0]
 (-50, 0.1, 50) ; PLACEBO[STUDY=6,TIME=2]
 (-50, 0.1, 50) ; PLACEBO[STUDY=6,TIME=4]
$OMEGA 16          ; ETA_E0
$SIGMA 1 FIX       ; ADD_ERR (weight = SE)
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999 PRINT=10 NSIG=3 SIGL=9 NOABORT
$COVARIANCE MATRIX=R PRINT=E
$TABLE ID STUDY TIME IPRED NOPRINT ONEHEADER FILE=sdtab FORMAT=s1PE15.8
