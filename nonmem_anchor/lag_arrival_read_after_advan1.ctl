$PROBLEM #1226 lagged arrival vs obs ordering (advan1, lag=0.29999999999999988)
$INPUT ID TIME DV AMT EVID CMT MDV
$DATA lag_arrival_read.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2

$PK
  CL    = THETA(1)
  V     = THETA(2)
  ALAG1 = THETA(3)
  K     = CL/V
  IF (AMT.GT.0.0) TDOS = TIME
  ARR = TDOS + ALAG1
  SEP = 8.2 - ARR

$ERROR
  IPRED = F
  Y = IPRED + EPS(1)
$THETA
  1.0 FIX
  10.0 FIX
  0.29999999999999988 FIX
$OMEGA 0 FIX
$SIGMA 1 FIX
$ESTIMATION METHOD=0 MAXEVAL=0 PRINT=1 NOABORT
$TABLE ID TIME PRED IPRED ALAG1 ARR SEP EVID NOPRINT ONEHEADER FORMAT=s1PE23.16 FILE=lag_arrival_read_after_advan1.tab
