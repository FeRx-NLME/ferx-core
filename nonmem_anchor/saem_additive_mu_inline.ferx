# #2544 inline twin of saem_additive_mu.ferx: the same model with E0 folded into
# BASE. The line adds one bare theta (TVE0), one eta (ETA_E0) and a term that reads
# neither (PLAFIX), and TVE0 and ETA_E0 reach the model through nothing else, so it
# is the same additive mu-reference as `E0 = TVE0 + ETA_E0` and SAEM moves TVE0 by
# the same closed-form shift. The NONMEM twin is saem_additive_mu_inline.ctl
# (BASE = MU_1 + PLA + ETA(1)), bit-identical to saem_additive_mu.ctl. Before #2544
# this line was not a mu-reference; saem_additive_mu_shared.ferx is that control.

[parameters]
  theta TVE0(45.0, 0.0, 200.0)
  theta EMAX(13.4506) FIX
  theta ED50(31.4307) FIX
  theta ET50(3.526) FIX

  omega ETA_E0 ~ 4.0 (sd)

  sigma ADD_ERR ~ 1.0 (variance) FIX

[covariates]
  DOSE   continuous
  SE     continuous
  PLAFIX continuous

[individual_parameters]
  BASE = TVE0 + PLAFIX + ETA_E0

[structural_model]
  DRUG = EMAX * DOSE / (ED50 + DOSE) * TIME / (TIME + ET50)
  y    = BASE - DRUG

[error_model]
  DV ~ additive(ADD_ERR) weight = SE

[fit_options]
  method     = saem
  covariance = false
