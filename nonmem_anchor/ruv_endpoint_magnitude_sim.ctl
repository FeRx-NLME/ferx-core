$PROBLEM Simulate two-endpoint dataset for the #2731 anchor
$DATA ruv_endpoint_magnitude.csv IGNORE=@
$INPUT ID TIME DV EVID AMT CMT RATE MDV EARLY ISUR
$SUBROUTINES ADVAN6 TOL=9
$MODEL COMP=(CENTRAL) COMP=(EFFECT)
$PK
  CL  = THETA(1)*EXP(ETA(1))
  V   = THETA(2)*EXP(ETA(2))
  KE0 = THETA(3)
  S1  = V
$DES
  DADT(1) = -CL/V*A(1)
  DADT(2) = KE0*(A(1)/V - A(2))
$ERROR
  IPRED = F
  FAC = 1 + (THETA(4)-1)*EARLY
  IF (CMT.EQ.1) THEN
    Y = IPRED + EPS(1)*FAC
  ELSE
    Y = IPRED + EPS(2)
  ENDIF
$THETA 2.0 20.0 0.5 1.8
$OMEGA 0.09 0.04
$SIGMA 0.04
$SIGMA 0.09
$SIMULATION (27310) ONLYSIMULATION
$TABLE ID TIME DV EVID AMT CMT RATE MDV EARLY ISUR NOHEADER NOPRINT NOAPPEND FORMAT=s1PE17.9 FILE=sim.tab
