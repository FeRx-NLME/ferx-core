# covmuref_power with the weight ratio assigned in both arms of an if/else —
# ferx side of the #1422 anchor.
#
# Before #1422 the covariate mu-reference scan inlined only top-level locals,
# so `WTN` stayed an unresolved name, `CL` had no covariate group and TH_WT rode
# the eta-frozen numerical M-step (this was `covmuref_power_numeric_saem_fit
# .ferx`, the #1415 fixture). A local every arm of an `if`/`else` assigns from
# data is now folded into the conditional that computes it, so this is the
# same group as `covmuref_power_saem_fit.ferx` — `(WT/70)^TH_WT` written the
# way renal and size covariates usually are — and NONMEM's MU_1 for it is the
# same `LOG(THETA(1)) + THETA(2)*LOG(WT/70)`: every subject has WT > 0, so the
# else arm is never taken. Anchor: nonmem_anchor/results/covmuref_power_saem.ext.
#
# Data: data/covmuref_power.csv (nonmem_anchor/simulate_covmuref_data.py).
# Truths: TVCL=5, TH_WT=0.75, TVV=50, omega^2 = 0.09 (CL), 0.04 (V),
#         sigma (SD) = 0.10. Starts deliberately away from truth.

[parameters]
  theta TVCL(4.0,   0.0, 100.0)
  theta TH_WT(0.3, -2.0,   3.0)
  theta TVV(40.0,   1.0, 500.0)

  omega ETA_CL ~ 0.1
  omega ETA_V  ~ 0.1

  sigma PROP_ERR ~ 0.02

[individual_parameters]
  if (WT > 0) {
    WTN = WT / 70.0
  } else {
    WTN = 1.0
  }
  CL = TVCL * WTN ^ TH_WT * exp(ETA_CL)
  V  = TVV * exp(ETA_V)

[structural_model]
  pk one_cpt_iv(cl=CL, v=V)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method = saem
  seed = 619
