# ferx twin of nonmem_anchor/iov_rule_reset_{A,B}.ctl -- the occasion a reset row re-seeds
# `init(central)` under, when the occasion is derived by `iov_occasion`.
#
# The file reads the OCC column (`iov_column`) so the anchor can drive every cell from one
# model: the column fit as written, a derived rule over the column's labels, and a derived
# rule with the labels cleared, which is what the reader returns without `iov_column`.
# KAPPA_B is in BASE, which reaches the prediction only through the init seed, and in CL.
[parameters]
  theta TVCL(5.0, 0.01, 100.0)
  theta TVV(50.0, 1.0, 500.0)
  theta TVBASE(100.0, 0.01, 1000.0)
  omega ETA_CL ~ 0.04
  kappa KAPPA_B ~ 0.09
  sigma PROP ~ 0.05 (sd)
[individual_parameters]
  CL   = TVCL * exp(ETA_CL + KAPPA_B)
  V    = TVV
  BASE = TVBASE * exp(KAPPA_B)
[structural_model]
  ode(obs_cmt=central, states=[central])
[odes]
  init(central)  = BASE
  d/dt(central)  = -(CL/V) * central
[scaling]
  obs_scale = V
[error_model]
  DV ~ proportional(PROP)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
  ode_reltol = 1e-10
  ode_abstol = 1e-12
  iov_column = OCC
