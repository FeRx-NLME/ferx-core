$PROBLEM warfarin FOCEI eval-only at the NONMEM MLE (6 sig. fig.), MATRIX=S PRINT=E (#2974)
$INPUT ID TIME DV EVID AMT CMT=DROP RATE MDV
$DATA warfarin.csv IGNORE=@
$SUBROUTINES ADVAN2 TRANS2
$PK
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)*EXP(ETA(2))
  KA = THETA(3)*EXP(ETA(3))
  S2 = V
$ERROR
  IPRED = F
  Y = IPRED*(1 + THETA(4)*EPS(1))
$THETA (0.001, 0.132695, 10)  ; TVCL
$THETA (0.1, 7.73775, 500)    ; TVV
$THETA (0.01, 0.8108, 50)    ; TVKA
$THETA (0, 0.0105651)           ; PROP_ERR (SD)
$OMEGA 0.0285883 0.00959254 0.335859
$SIGMA 1 FIX
$ESTIMATION METHOD=1 INTER MAXEVAL=0 NOABORT
$COVARIANCE MATRIX=S PRINT=E
