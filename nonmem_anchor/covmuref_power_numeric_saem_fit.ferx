# covmuref_power with the weight covariate routed through a conditionally
# assigned local — the #1415 regression fixture.
#
# `classify_covariate_mu_ref` rejects a typical value that reads a local the
# inliner cannot resolve (assigned conditionally or later), so unlike
# `covmuref_power_saem_fit.ferx` this model has *no* covariate mu-reference
# group: TVCL keeps its single-anchor mu-reference and TH_WT carries no ETA and
# rides the eta-frozen numerical M-step. (#1422 tracks inlining an if/else-
# assigned local; when that lands, this fixture needs a shape that still
# defeats detection — the test asserts `covariate_mu_refs.is_empty()`.) That is the shape #1415 reports on
# real models (a CrCL exponent written through an `if`/`else` CRCL, an
# allometric or maturation exponent, an inter-compartmental clearance) — and
# the NONMEM SAEM anchor is the same MLE as the grouped model's:
# `nonmem_anchor/results/covmuref_power_saem.ext`, TH_WT = 0.921.
#
# Data: data/covmuref_power.csv (nonmem_anchor/simulate_covmuref_data.py).
# Truths: TVCL=5, TH_WT=0.75, TVV=50, omega^2 = 0.09 (CL), 0.04 (V),
#         sigma (SD) = 0.10. Starts deliberately away from truth.

[parameters]
  theta TVCL(4.0,   0.0, 100.0)
  theta TH_WT(0.3, -2.0,   3.0)
  theta TVV(40.0,   1.0, 500.0)

  omega ETA_CL ~ 0.1
  omega ETA_V  ~ 0.1

  sigma PROP_ERR ~ 0.02

[individual_parameters]
  if (WT > 0) {
    WTN = WT / 70.0
  } else {
    WTN = 1.0
  }
  CL = TVCL * WTN ^ TH_WT * exp(ETA_CL)
  V  = TVV * exp(ETA_V)

[structural_model]
  pk one_cpt_iv(cl=CL, v=V)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method = saem
  seed = 619
