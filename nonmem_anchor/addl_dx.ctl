$PROBLEM #1909: which record's $PK sets D1 / R1 for an ADDL-implied dose (D1 = X, R1 = 50/X)
; IDs 1-2 and 5 code RATE=-2 (D1), IDs 3-4 and 6 code RATE=-1 (R1); 5-6 hold X constant
$INPUT ID TIME DV MDV EVID AMT RATE CMT ADDL II X
$DATA addl_inf.csv IGNORE=@
$SUBROUTINES ADVAN1 TRANS2
$PK
  CL = THETA(1)*EXP(ETA(1))
  V  = THETA(2)
  D1 = X
  R1 = 50/X
  S1 = V
$ERROR
  IPRED = F
  Y = IPRED*(1 + EPS(1))
$THETA (0.5 FIX) (10 FIX)
$OMEGA 0.01 FIX
$SIGMA 0.01 FIX
$ESTIMATION METHOD=0 MAXEVAL=0 PRINT=1 NOABORT
$TABLE ID TIME EVID MDV RATE X PRED NOPRINT ONEHEADER FORMAT=s1PE23.16 FILE=addl_dx.tab
