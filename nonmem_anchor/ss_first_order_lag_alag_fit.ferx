# SS=1 dose into an explicit depot with a COMPARTMENT lag ALAG1 on it (#2786); twin of
# ss_first_order_lag.ctl (ADVAN2, ALAG1 = LG).  Expected values: ss_absorption_lag_ref_fo.csv.
# A plain depot compartment: the SS bolus (IDs 11-16) and the SS infusion longer than II
# (ID 17) both take the long-standing plain-compartment steady-state paths.

[parameters]
  theta TVCL(2.0, 0.1, 100.0)
  theta TVV(20.0, 1.0, 500.0)
  theta TVKA(0.7, 0.01, 24.0)
  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09
  sigma PROP_ERR ~ 0.0025
[individual_parameters]
  CL    = TVCL * (WT/70)^0.75 * exp(ETA_CL)
  V     = TVV * exp(ETA_V)
  KA    = TVKA
  ALAG1 = LG
[structural_model]
  ode(obs_cmt=central, states=[depot, central])
[odes]
  d/dt(depot)   = -KA*depot
  d/dt(central) = KA*depot - CL/V*central
[scaling]
  obs_scale = V
[covariates]
  WT continuous
  LG continuous
[error_model]
  DV ~ proportional(PROP_ERR)
[fit_options]
  method = focei
  maxiter = 0
  covariance = false
  ode_method = rk45
  ode_reltol = 1e-12
  ode_abstol = 1e-12
