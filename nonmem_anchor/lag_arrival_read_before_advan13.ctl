$PROBLEM #1226 lagged arrival vs obs ordering (advan13, lag=0.29999999999986676)
$INPUT ID TIME DV AMT EVID CMT MDV
$DATA lag_arrival_read.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=9
$MODEL
  COMP=(CENTRAL,DEFDOSE,DEFOBS)
$PK
  CL    = THETA(1)
  V     = THETA(2)
  ALAG1 = THETA(3)
  K     = CL/V
  IF (AMT.GT.0.0) TDOS = TIME
  ARR = TDOS + ALAG1
  SEP = 8.2 - ARR
$DES
  DADT(1) = -K*A(1)
$ERROR
  IPRED = A(1)/V
  Y = IPRED + EPS(1)
$THETA
  1.0 FIX
  10.0 FIX
  0.29999999999986676 FIX
$OMEGA 0 FIX
$SIGMA 1 FIX
$ESTIMATION METHOD=0 MAXEVAL=0 PRINT=1 NOABORT
$TABLE ID TIME PRED IPRED ALAG1 ARR SEP EVID NOPRINT ONEHEADER FORMAT=s1PE23.16 FILE=lag_arrival_read_before_advan13.tab
