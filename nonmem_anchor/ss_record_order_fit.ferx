# ferx twin of dtmm_ss_record_order.ctl (#2510): ADVAN1 TRANS2, CL = 1, V = 10, every
# parameter fixed. A Gaussian observation listed before a same-TIME SS=1 dose reads the
# amounts carried from the previous record; one listed after it, the steady state.
[parameters]
  theta TVCL(1.0, 0.01, 100.0)
  theta TVV(10.0, 0.1, 1000.0)
  sigma ADD ~ 1.0
[individual_parameters]
  CL = TVCL
  V  = TVV
[structural_model]
  pk one_cpt_iv(cl=CL, v=V)
[error_model]
  DV ~ additive(ADD)
[fit_options]
  method = foce
  maxiter = 0
  covariance = false
