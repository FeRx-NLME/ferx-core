$PROBLEM zero_fix_eta_null  the same model with the six placeholders removed (#3150)
$INPUT ID TIME DV EVID AMT CMT RATE MDV
$DATA zero_fix_eta.csv IGNORE=@
$SUBROUTINES ADVAN3 TRANS4
$PK
  CL = THETA(1) * EXP(ETA(1))
  V1 = THETA(2) * EXP(ETA(2))
  Q  = THETA(3) * EXP(ETA(3))
  V2 = THETA(4) * EXP(ETA(4))
  S1 = V1
$ERROR
  IPRED = F
  Y = IPRED * (1 + EPS(1))
$THETA (0.1, 4.0, 100.0)    ; TVCL
$THETA (1.0, 12.0, 500.0)   ; TVV1
$THETA (0.01, 2.0, 100.0)   ; TVQ
$THETA (1.0, 25.0, 500.0)   ; TVV2
$OMEGA 0.15
$OMEGA 0.15
$OMEGA 0.15
$OMEGA 0.15
$SIGMA 0.0004
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=0 POSTHOC NOABORT PRINT=1
$TABLE ID TIME IPRED NOPRINT ONEHEADER FILE=zero_fix_eta_null.tab FORMAT=,1PE17.10
