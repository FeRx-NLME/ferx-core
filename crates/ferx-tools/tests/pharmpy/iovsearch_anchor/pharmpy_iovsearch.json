  "final_model_code": "$PROBLEM IIV([CL]+[V]+[KA]);IOV([CL]+[V]+[KA])\n$DATA iov_sim.csv IGNORE=@\n$INPUT ID TIME DV EVID AMT CMT=DROP RATE MDV OCC\n$SUBROUTINES ADVAN2 TRANS2\n$ABBR REPLACE ETA_IOV_1_1=ETA(4)\n$ABBR REPLACE ETA_IOV_1_2=ETA(5)\n$ABBR REPLACE ETA_IOV_1_3=ETA(6)\n$PK\n      IOV_1 = 0\nIF (OCC.EQ.1) IOV_1 = ETA_IOV_1_1\nIF (OCC.EQ.2) IOV_1 = ETA_IOV_1_2\nIF (OCC.EQ.3) IOV_1 = ETA_IOV_1_3\nIOV_2 = 0\nIF (OCC.EQ.1.OR.OCC.EQ.2) IOV_2 = 0\nIOV_3 = 0\nIF (OCC.EQ.1.OR.OCC.EQ.2) IOV_3 = 0\nETAI1 = IOV_1 + ETA(1)\nETAI2 = IOV_2 + ETA(2)\nETAI3 = IOV_3 + ETA(3)\nCL = THETA(1)*EXP(ETAI1)\nV = THETA(2)*EXP(ETAI2)\nKA = THETA(3)*EXP(ETAI3)\n  S2 = V\n$ERROR\n  IPRED = F\n  Y = IPRED + IPRED*EPS(1)\n$THETA (0, 0.5)    ; TVCL\n$THETA (0, 10.0)   ; TVV\n$THETA (0, 1.2)    ; TVKA\n$OMEGA 0.09        ; ETA_CL\n$OMEGA 0.04        ; ETA_V\n$OMEGA 0.30        ; ETA_KA\n$OMEGA  BLOCK(1)\n0.009 ; OMEGA_IOV_1\n$OMEGA  BLOCK(1) SAME\n$OMEGA  BLOCK(1) SAME\n$SIGMA 0.04        ; sigma^2 (SD 0.2)\n$ESTIMATION METHOD=COND INTERACTION MAXEVAL=9999 PRINT=5 NOABORT\n$TABLE ID TIME DV MDV IPRED CWRES NOPRINT ONEHEADER FILE=sdtab\n",
