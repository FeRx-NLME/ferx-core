# Benchmark fixture: warfarin_ode.ferx with Gauss-Newton-anchored FOCEI quadrature
# ("focei, n_agq > 1"). Only reachable for the GaussNewton anchor
# (`estimation::focei_htilde_dx`) — the Exact-anchor Laplace module declines ODE outright.

[parameters]
  theta TVCL(0.2, 0.001, 10.0)
  theta TVV(10.0, 0.1, 500.0)
  theta TVKA(1.5, 0.01, 50.0)

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.04
  omega ETA_KA ~ 0.30

  sigma PROP_ERR ~ 0.02 (sd)

[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V  = TVV  * exp(ETA_V)
  KA = TVKA * exp(ETA_KA)

[structural_model]
  ode(obs_cmt=central, states=[depot, central])

[odes]
  d/dt(depot)   = -KA * depot
  d/dt(central) =  KA * depot / V - (CL/V) * central

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method     = focei
  n_agq      = 3
  maxiter    = 300
  covariance = false
