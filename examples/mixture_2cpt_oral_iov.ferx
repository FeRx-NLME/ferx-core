# Two-compartment oral model with a lag, IOV on CL and a two-class mixture
#
# Data: data/mixture_2cpt_oral_iov.csv, written by `python3 tools/sim_mixture_2cpt_oral_iov.py`
# (deterministic, seed 977; not committed, 570 KB): 120 subjects, 100 mg every 12 h for 200
# doses (one record per dose), four
# occasions of 50 doses, each sampled at 1, 3, 6 and 11.5 h after its last dose. True values:
# TVCL1 = 2, TVCL2 = 6 (class 1 with probability 0.6), TVV1 = 30, TVQ = 5, TVV2 = 60,
# TVKA = 1, TVLAG = 0.5; omega_CL = omega_V1 = 0.09, omega_KA = 0.16, IOV on CL 0.04;
# proportional SD 0.1. The starting values below are deliberately off the truth.
# The fixture for the mixture outer-optimizer measurements: a long dose history, an
# estimated lag, IOV and a latent class in one closed-form model.

[parameters]
  theta TVCL1(1.5, 0.01, 100.0)
  theta TVCL2(8.0, 0.01, 100.0)
  theta TVV1(25.0, 0.1, 1000.0)
  theta TVQ(4.0, 0.01, 100.0)
  theta TVV2(50.0, 0.1, 1000.0)
  theta TVKA(0.8, 0.01, 50.0)
  theta TVLAG(0.4, 0.01, 5.0)
  theta MIXL(0.0, -10.0, 10.0)

  omega ETA_CL ~ 0.1
  omega ETA_V1 ~ 0.1
  omega ETA_KA ~ 0.1
  kappa KAPPA_CL ~ 0.05

  sigma PROP_ERR ~ 0.1 (sd)

[mixture]
  nsub = 2
  logit(1) = MIXL

[individual_parameters]
  CL = if (MIXNUM == 1) TVCL1 * exp(ETA_CL + KAPPA_CL) else TVCL2 * exp(ETA_CL + KAPPA_CL)
  V1 = TVV1 * exp(ETA_V1)
  Q  = TVQ
  V2 = TVV2
  KA = TVKA * exp(ETA_KA)
  LAG = TVLAG

[structural_model]
  pk two_cpt_oral(cl=CL, v1=V1, q=Q, v2=V2, ka=KA, lagtime=LAG)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method     = focei
  iov_column = OCC
  covariance = true
