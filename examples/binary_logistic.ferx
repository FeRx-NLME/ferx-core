# Binary / logistic endpoint (Phase 4 categorical, Track C — #760).
#
# Fixed-effects (n_eta = 0) logistic regression: DV ∈ {0,1} on CMT 3, with a subject
# covariate X and the per-record TIME builtin in the log-odds. This is the n_eta = 0
# special case (no random effects) — the exact analogue of ordinary base-R
# `glm(DV ~ X + TIME, family = binomial)`.
#
#   logit P(DV = 1) = TH0 + THX * X + THT * TIME
#
# Data: data/binary_logistic.csv (60 subjects × 3 times; data-generating
# TH0 = -0.4, THX = 0.9, THT = 0.5). Reference glm fit:
#   (Intercept) = -0.7752, X = 0.8701, TIME = 0.8270   (deviance 213.60).
#
# Run:  cargo run --release -- examples/binary_logistic.ferx --data data/binary_logistic.csv

[parameters]
  theta TH0(0.0, -10.0, 10.0)
  theta THX(0.0, -10.0, 10.0)
  theta THT(0.0, -10.0, 10.0)

[covariates]
  X continuous

[binary_model]
  cmt   = 3
  logit = TH0 + THX * X + THT * TIME

[fit_options]
  method  = focei
  maxiter = 300
