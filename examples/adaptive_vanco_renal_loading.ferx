# Adaptive (feedback) dosing — vancomycin LOADING DOSE + maintenance titration
# under a time-varying renal covariate (epic #391 / #702 / #930)
#
# The #930 combination: a pre-scheduled BASE REGIMEN (a loading dose, #702) AND a
# time-varying covariate driving PK (#700). It merges two shipped examples —
# adaptive_vanco_loading.ferx (the loading dose) and adaptive_vanco_renal.ferx (the
# declining-CRCL clearance) — into the one scenario each of them scoped out: a base
# regimen under a time-varying covariate. #702 rejected that combination; #930 lifts
# it for plain bolus / infusion base doses, resolving each base dose's bioavailability
# F from its own covariate snapshot and integrating it under the per-segment PK.
#
# The loading dose is NOT in this file: it rides on the subject data
# (tests/reference/vanco_renal_loading_mrgsolve/vanco_renal_loading_subject.csv carries
# a 1500 mg bolus at t=0). The reactive driver integrates that pre-scheduled dose under
# the declining CRCL and the controller titrates the daily maintenance dose on top of
# the (now covariate-aware) trough.
#
# The decision schedule starts at t=24 (after the loading dose), so the day-1 trough the
# controller sees is the decayed loading dose — decayed under CRCL(24), the end-of-interval
# clearance — not 0. As renal function declines, clearance falls and drug accumulates, so
# the controller must eventually back the maintenance dose down: the covariate genuinely
# drives the ladder on top of the base regimen.
#
# `auc_target` is deliberately absent: its exposure metric integrates a dense grid from a
# single frozen PK snapshot, silently wrong under a changing covariate, so it is a typed
# error for a time-varying-covariate subject (#700). `target_window` (the pct-in-band trough
# metric) stays — it is a per-event covariate-aware decision-grid summary.
#
# Run with `simulate_adaptive_from_spec()` (not the plain forward `simulate()`). Validated
# dose-for-dose against an independent mrgsolve run (mrgsolve, not NONMEM, is the
# feedback-dosing comparator); see tests/reference/vanco_renal_loading_mrgsolve/ and
# tests/adaptive_vanco_renal_loading_anchor.rs.
#
# Negligible IIV: ETA_CL carries a vanishing variance, so the patient is effectively
# typical-value and the CRCL trajectory is the sole source of PK variation — the realized
# ladder is reproducible and bit-comparable to the typical-value mrgsolve run.

[parameters]
  theta TVCL(4.0,  0.1,  50.0)   # vancomycin clearance at CRCL = 100 mL/min (L/h)
  theta TVV(80.0,  5.0, 300.0)   # central volume (L); CENT/V is the concentration

  # Negligible IIV: the engine requires at least one omega, so CL carries a vanishing
  # variance. The patient is effectively typical-value and the ladder is reproducible.
  omega ETA_CL ~ 1e-10

  sigma ADD ~ 1.0                # nominal additive error; the latent `observe` signal is
                                 # un-noised, so it never enters the dose decisions.

[individual_parameters]
  CL = TVCL * CRCL / 100.0       # clearance scales linearly with renal function
  V  = TVV                       # (CRCL is the time-varying covariate that declines)

[structural_model]
  ode(states=[CENT])

[odes]
  d/dt(CENT) = -(CL / V) * CENT  # 1-cpt IV; the loading + maintenance boluses enter CENT

[scaling]
  y = CENT / V                   # observed/predicted endpoint: concentration (mg/L)

[error_model]
  DV ~ additive(ADD)

[adaptive_dosing]
  observe       = CENT / V               # titrate on the latent trough concentration
  at            = every 24 from 24 to 192 # daily MAINTENANCE decisions, after the load
  start_dose    = 750                    # empiric maintenance start (mg): subtherapeutic
  route         = bolus(cmt=1)           # maintenance boluses into the drug compartment
  dose_bounds   = [250, 4000]            # mg
  target_window = [10, 15]               # report % of days with trough in [10, 15] mg/L
  when signal < 10 : increase 25%        # subtherapeutic trough -> raise the dose
  when signal > 15 : decrease 25%        # supratherapeutic trough -> lower the dose
