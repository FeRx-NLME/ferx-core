# Global model search over examples/warfarin.ferx (#1185).
#
#   ferx globalsearch examples/warfarin_globalsearch.ferxsearch
#
# Where modelsearch and covsearch walk one axis of the model space at a time,
# this lays the structural categories and the optional covariate pairs out as
# ONE grid and searches it globally: pyDarwin's genetic algorithm by default,
# or every point with `algorithm = "exhaustive"`. The grid below is
#   PERIPHERALS (0, 1) x LAGTIME (OFF, ON) x CL-WT (none, power, linear)
#   x V-WT (none, power, linear) x KA-WT (none, power, linear)
# = 108 points; the GA evaluates a fraction of them. Set `exhaustive` to fit
# all 108 (a few minutes with the covariance step on this dataset).
#
# Ranking is pyDarwin's penalized fitness: OFV + 10 per estimated parameter
# + 100 per failure (non-convergence, no covariance step, |r| > 0.95,
# condition number > 1000). `[rank.penalties]` changes any charge; `type =
# "bic"` ranks on the mixed BIC instead. See docs/tools/global-search.qmd for
# when a global search beats the stepwise tools, and when it does not.

base = "warfarin.ferx"
data = "../data/warfarin.csv"

[space]
mfl = """
ABSORPTION(FO); PERIPHERALS(0..1); LAGTIME([OFF,ON])
COVARIATE?(@IIV, WT, [pow,lin])
"""

[globalsearch]
algorithm    = "ga"                   # or "exhaustive"
iiv_strategy = "absorption_delay"     # eta on a new lag time / mean transit time only

[globalsearch.ga]
population_size = 16
generations     = 6
seed            = 1185

[rank]
type = "penalized"                    # the default for this tool

[strictness]
require_converged    = true
max_condition_number = 1000.0
max_correlation      = 0.95
reject_on_boundary   = true

[run]
threads   = 4
retries   = 2
cache_dir = ".ferx-globalsearch"
