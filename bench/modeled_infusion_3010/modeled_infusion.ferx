# #3010's shape: a modeled-duration infusion (RATE=-2) into a depot, with IIV on its duration
# (so the infusion end moves with eta) and on its bioavailability, 2-compartment linear [odes].
# Initial estimates are deliberately off the simulation's truth (CL 4, V1 30, Q 2, KA 1,
# D1 2), so the EBE searches sweep the infusion ends across the samples.
[parameters]
  theta TVCL(8.0, 0.1, 100.0)
  theta TVV1(15.0, 1.0, 500.0)
  theta TVQ(5.0, 0.01, 100.0)
  theta TVV2(50.0, 1.0, 1000.0)
  theta TVKA(0.4, 0.01, 20.0)
  theta TVD1(4.0, 0.1, 24.0)
  theta WT_CL(0.75, -2.0, 3.0)
  theta WT_V(1.0, -2.0, 3.0)
  omega ETA_CL ~ 0.1
  omega ETA_V1 ~ 0.1
  omega ETA_D1 ~ 0.4
  omega ETA_F1 ~ 0.05
  sigma PROP_ERR ~ 0.02
[individual_parameters]
  CL = TVCL * (WT/70)^WT_CL * exp(ETA_CL)
  V1 = TVV1 * (WT/70)^WT_V * exp(ETA_V1)
  Q = TVQ
  V2 = TVV2
  KA = TVKA
  D1 = TVD1 * exp(ETA_D1)
  F1 = exp(ETA_F1)
[structural_model]
  ode(states=[depot, central, peri])
[odes]
  d/dt(depot) = -KA * depot
  d/dt(central) = KA * depot - (CL/V1) * central - (Q/V1) * central + (Q/V2) * peri
  d/dt(peri) = (Q/V1) * central - (Q/V2) * peri
[scaling]
  y = central / V1
[error_model]
  DV ~ proportional(PROP_ERR)
[fit_options]
  method = focei
