# Bench B2-ODE: ODE twin of pk2.ferx (2-cpt oral, amounts + [scaling]). Analytic optimum is the oracle.
[parameters]
  theta TVCL(2.0, 0.1, 100.0)
  theta TVV1(20.0, 1.0, 500.0)
  theta TVQ(4.0, 0.1, 100.0)
  theta TVV2(150.0, 1.0, 1000.0)
  theta TVKA(0.6, 0.01, 10.0)
  theta THETA_WT(0.3, -3.0, 5.0)
  theta THETA_CRCL(0.1, -3.0, 5.0)

  block_omega (ETA_CL, ETA_V1) = [0.2, 0.01, 0.2]
  omega ETA_V2 ~ 0.2
  omega ETA_KA ~ 0.2

  sigma PROP_ERR ~ 0.2 (sd)
  sigma ADD_ERR ~ 0.2 (sd)

[individual_parameters]
  CL = TVCL * (WT / 70)^THETA_WT * (CRCL / 100)^THETA_CRCL * exp(ETA_CL)
  V1 = TVV1 * (WT / 70) * exp(ETA_V1)
  Q  = TVQ
  V2 = TVV2 * exp(ETA_V2)
  KA = TVKA * exp(ETA_KA)

[structural_model]
  ode(obs_cmt=central, states=[depot, central, peripheral])

[odes]
  d/dt(depot)      = -KA * depot
  d/dt(central)    = KA * depot - (CL + Q) / V1 * central + Q / V2 * peripheral
  d/dt(peripheral) = Q / V1 * central - Q / V2 * peripheral

[scaling]
  y = central / V1

[covariates]
  WT   continuous
  CRCL continuous

[error_model]
  DV ~ combined(PROP_ERR, ADD_ERR)

[fit_options]
  method     = focei
  maxiter    = 1000
  covariance = false
