# #3159: a one-state decay restarted at each occasion (EVID = 4), observed through a clip at a
# threshold that carries IIV and IOV. Each record that crosses the threshold puts a kink in the
# individual objective. Generated by tests/fixtures/clipped_decay/make_data.py (seed 41);
# the six subjects are the ones whose EBE the inner search got wrong before the fix.
[parameters]
  theta TVBASE(10.0, 0.1, 100.0)
  theta K(0.15, 0.001, 5.0)
  theta TVTH(4.0, 0.01, 50.0)
  omega ETA_BASE ~ 0.04
  omega ETA_TH ~ 0.09
  kappa KAPPA_TH ~ 0.04
  sigma ADD_ERR ~ 0.15 (sd)
[individual_parameters]
  BASE = TVBASE * exp(ETA_BASE)
  KI = K
  TH = TVTH * exp(ETA_TH + KAPPA_TH)
  F1 = BASE
[structural_model]
  ode(obs_cmt=eff, states=[eff])
[odes]
  d/dt(eff) = -KI * eff
[scaling]
  y = if (eff - TH < 0) 0 else eff - TH
[error_model]
  DV ~ additive(ADD_ERR)
[fit_options]
  method     = foce
  maxiter    = 0
  covariance = false
  iov_column = OCC
  ode_reltol = 1e-10
  ode_abstol = 1e-12
