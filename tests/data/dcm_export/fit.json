AL_PK.CL * exp(ETA_CL)   # clearance from the network\n  V  = TVV * exp(ETA_V)\n  KA = TYPICAL_PK . KA * exp(ETA_KA)\n\n[structural_model]\n  pk one_cpt_oral(cl=CL, v=V, ka=KA)\n\n[error_model]\n  DV ~ proportional(PROP_ERR)\n","multi_start_seed":null,"n_iterations":0,"n_obs":0,"n_parameters":0,"n_starts":1,"n_subjects":0,"n_threads_used":1,"neural_networks":[],"nlopt_missing_algorithms":[],"npde_seed":null,"obs_time_range":null,"ode_linear_exact":false,"ofv":0.0,"ofv_data":0.0,"ofv_prior":0.0,"omega":{"cols":3,"data":[0.0912,0.0,0.0,0.0,0.0437,0.0,0.0,0.0,0.3125],"rows":3},"omega_fixed":[],"omega_init":{"cols":0,"data":[],"rows":0},"omega_init_as_sd":[],"omega_iov":null,"omega_iov_param_corr":null,"omega_is_diagonal":null,"omega_param_corr":null,"optimizer":"","outer_gtol":0.0,"outer_maxiter":0,"population_fingerprint":null,"reader_settings":null,"saem_mu_ref_m_step_evals_saved":null,"saem_n_subjects_hmc":null,"saem_seed":null,"schema_version":1,"scoring_settings":null,"se_kappa":null,"se_omega":null,"se_sigma":null,"se_theta":null,"shrinkage_eps":null,"shrinkage_eta":[],"shrinkage_kappa":[],"shrinkage_kappa_by_occ":[],"sigma":[0.1234],"sigma_fixed":[],"sigma_init":[],"sigma_init_as_sd":[],"sigma_names":["PROP_ERR"],"sigma_types":[],"sir_ci_kappa":null,"sir_ci_omega":null,"sir_ci_sigma":null,"sir_ci_theta":null,"sir_ess":null,"sir_resamples_packed":null,"sir_seed":null,"sir_settings":null,"subjects":[],"theta":[31.5,0.29552020666133955,1.0391970592293505,-0.6812178954537766,-1.1039492679371252,1.1455227773406622,1.0027151878144487,-1.6337206970902447,-0.7164585644736541,2.0828732172749485,0.24629406239872925,-2.42802361832017,0.38539853913330596,2.608843109362888,-1.1358733803469512,-2.5761210078297885,1.9449100695201234,2.297502961152464,-2.739502212547247,-1.7619321248456368,3.439985791099096,0.9823461409698496,-3.967115413772459,0.0036795067665148728],"theta_fixed":[],"theta_init":[],"theta_names":["TVV","W_TYPICAL_PK_1_1_1","W_TYPICAL_PK_1_1_2","W_TYPICAL_PK_1_