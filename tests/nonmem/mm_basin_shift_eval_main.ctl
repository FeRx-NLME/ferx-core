$PROBLEM ferx-core #1565 MM ODE basin-shift reference (eval_main)
; #1565: NONMEM 7.6.0 FOCEI evaluated (MAXEVAL=0, MCETA=200) at the estimates pre-#1565
; ferx reported as converged (ferx OFV 784.332). Result: OBJV 784.349 (see .ext).
$INPUT ID TIME DV EVID AMT CMT MDV
$DATA ../fixtures/mm_basin_shift/mm_n200.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=10
$MODEL COMP=(DEPOT DEFDOSE) COMP=(CENTRAL)
$PK
  VMAX = THETA(1)*EXP(ETA(1))
  KM   = THETA(2)
  V    = THETA(3)*EXP(ETA(2))
  KA   = THETA(4)*EXP(ETA(3))
$DES
  DADT(1) = -KA*A(1)
  DADT(2) = KA*A(1)/V - VMAX*A(2)/(KM+A(2))
$ERROR
  IPRED = A(2)
  Y = IPRED*(1+EPS(1))
$THETA (0.1,1.260806,50) (0.1,4.243931,100) (1,10.298585,200) (0.05,0.924763,20)
$OMEGA 0.119879 0.104037 0.213265
$SIGMA 0.011045
$ESTIMATION METHOD=1 INTER MAXEVAL=0 NOABORT PRINT=5 SIGDIGITS=4 MCETA=200
