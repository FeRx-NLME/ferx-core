{
 "nonmem_version": "7.5.1",
 "data_file": "mixture_iv_iov.csv",
 "data_records": 300,
 "observations": 240,
 "individuals": 30,
 "nmtran_warnings": [2],
 "markers": [],
 "steps": [
  {
   "method": "First Order Conditional Estimation (Evaluation)",
   "objv": 585.6,
   "final": {
    "theta": [1.88, 10.3],
    "omega": {
     "ETA1": [0.05],
     "ETA2": [0.0, 0.02],
     "ETA3": [0.0, 0.0, 0.02]
    },
    "sigma": {
     "EPS1": [0.04]
    }
   },
   "markers": []
  }
 ],
 "control_stream_as_run": [
  "$PROBLEM    IOV CWRES anchor (FOCE,no INTER): 1-cpt IV,IIV +",
  ";           per-occasion kappa on CL,no mixture,MAXEVAL=0 POSTHOC",
  "; iov_cwres_focei.mod without INTER, so the CWRES residual variance is evaluated at ETA = 0",
  "",
  "; rather than at the EBEs. Everything else is identical.",
  "$INPUT      ID TIME DV AMT EVID CMT OCC WT",
  "$DATA      mixture_iv_iov.csv IGNORE=@",
  "$SUBROUTINE ADVAN1 TRANS2",
  "$PK",
  "  OCC1 = 0",
  "  OCC2 = 0",
  "  IF (OCC.EQ.1) OCC1 = 1",
  "  IF (OCC.EQ.2) OCC2 = 1",
  "  KACL = OCC1*ETA(2) + OCC2*ETA(3)",
  "  CL = THETA(1) * EXP(ETA(1) + KACL)",
  "  V  = THETA(2)",
  "  S1 = V",
  "",
  "$ERROR",
  "  IPRED = F",
  "  W = 0.2 * IPRED",
  "  IF (W.EQ.0) W = 1",
  "  IWRES = (DV - IPRED) / W",
  "  Y = IPRED * (1.0 + EPS(1))",
  "",
  "$THETA  (0.01,1.876,100.0) ; TVCL",
  " (0.1,10.2591,1000.0) ; V",
  "$OMEGA  0.05  FIX  ;  IIV on CL",
  "$OMEGA  BLOCK(1) FIX",
  " 0.02  ; IOV on CL, occasion 1",
  "$OMEGA  BLOCK(1) SAME",
  "$SIGMA  0.04  FIX  ; proportional RUV, SD 0.2",
  "$ESTIMATION METHOD=1 MAXEVAL=0 POSTHOC NOABORT",
  "$TABLE      ID TIME OCC EVID DV PRED IPRED IWRES CWRES ETA1 ETA2 ETA3",
  "            NOAPPEND NOPRINT ONEHEADER FORMAT=s1PE17.10",
  "            FILE=iov_cwres_foce.tab"
 ]
}
