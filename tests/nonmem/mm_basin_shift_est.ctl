$PROBLEM ferx-core #1565 MM ODE basin-shift reference (est)
; #1565: NONMEM 7.6.0 FOCEI estimation from the fixture's perturbed initial estimates.
; Result: MINIMIZATION TERMINATED DUE TO ROUNDING ERRORS, OBJV 814.840 (see .ext).
$INPUT ID TIME DV EVID AMT CMT MDV
$DATA ../fixtures/mm_basin_shift/mm_n200.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=10
$MODEL COMP=(DEPOT DEFDOSE) COMP=(CENTRAL)
$PK
  VMAX = THETA(1)*EXP(ETA(1))
  KM   = THETA(2)
  V    = THETA(3)*EXP(ETA(2))
  KA   = THETA(4)*EXP(ETA(3))
$DES
  DADT(1) = -KA*A(1)
  DADT(2) = KA*A(1)/V - VMAX*A(2)/(KM+A(2))
$ERROR
  IPRED = A(2)
  Y = IPRED*(1+EPS(1))
$THETA (0.1,0.8,50) (0.1,8,100) (1,15,200) (0.05,0.5,20)
$OMEGA 0.2 0.2 0.2
$SIGMA 0.04
$ESTIMATION METHOD=1 INTER MAXEVAL=9999 NOABORT PRINT=5 SIGDIGITS=4
