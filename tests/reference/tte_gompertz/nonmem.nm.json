  "$PROBLEM    TTE Gompertz (2-arm RCT,fixed effects) \u2013 Phase 1 ferx",
  ";           validation",
  "$INPUT      ID TIME DV TRT EVID CMT MDV",
  "$DATA      tte_gompertz.csv IGNORE=@",
  "$PRED",
  "  ALPHA  = EXP(THETA(1))     ; baseline hazard rate at t=0",
